---
import '../styles/global.css';
import CatChat from '../components/CatChat.astro';
import Lantern from '../components/Lantern.astro';
import FlowingSky from '../components/FlowingSky.astro';
interface Props { title?: string; desc?: string; nav?: string }
const { title = 'Introduce JJ', desc = '시작하면 쉽게 놓지 않는 개발자 권주회의 작업 기록', nav = '' } = Astro.props;
const links = [['/#about', '프로필'], ['/#skills', '기술'], ['/#projects', '프로젝트'], ['/#history', '이력'], ['/#contact', '연락']];
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title><meta name="description" content={desc} />
  <meta property="og:title" content={title} /><meta property="og:description" content={desc} /><meta name="theme-color" content="#f4efe5" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 98'%3E%3Cg transform='rotate(8 32 5)' stroke='%238e3a2a' stroke-linecap='round' stroke-linejoin='round' stroke-width='3.2' fill='%23fdfaf3'%3E%3Ccircle cx='32' cy='5.5' r='4.3'/%3E%3Crect x='24.5' y='13.5' width='15' height='3.3' rx='1'/%3E%3Crect x='19' y='16.8' width='26' height='4' rx='1.2'/%3E%3Cpath d='M19.5 20.8C5 27 4 56 19.5 62.5H44.5C60 56 59 27 44.5 20.8Z'/%3E%3Cpath d='M27.5 20.8C18.5 29 18.5 54.5 27.5 62.5M36.5 20.8C45.5 29 45.5 54.5 36.5 62.5' fill='none' stroke-width='2.4'/%3E%3Crect x='19' y='62.5' width='26' height='4' rx='1.2'/%3E%3Crect x='24.5' y='66.5' width='15' height='3.3' rx='1'/%3E%3Crect x='29.3' y='76' width='5.4' height='6' rx='1.6'/%3E%3Cg fill='none' stroke-width='2.2'%3E%3Cpath d='M29.8 82C29.3 87 28 91 27 95M32 82V97M34.2 82C34.7 87 36 91 37 95'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <script is:inline>try{if(localStorage.getItem('motion')==='off')document.documentElement.classList.add('paused')}catch(e){}</script>
</head>
<body>
  <a class="skip" href="#main">본문으로 건너뛰기</a>
  <div class="sky" aria-hidden="true"><div class="land"></div><FlowingSky /></div>
  </div>
  <header class="top"><div class="wrap">
    <a class="brand" href="/" aria-label="홈"><span class="mark"><Lantern /></span><span class="t">권주회 / 작업 기록</span></a>
    <nav class="nav" aria-label="주 메뉴">{links.map(([h, t]) => <a href={h} aria-current={nav === h ? 'page' : undefined}>{t}</a>)}</nav>
    <button class="mbtn" id="motion" type="button" aria-pressed="false">움직임 멈추기</button>
  </div></header>
  <main id="main"><slot /></main>
  <footer class="foot"><div class="wrap">
    <p>© 2026 Introduce JJ</p>
    
  </div></footer>
  <CatChat />
  <script is:inline>
    (function(){var b=document.getElementById('motion'),r=document.documentElement;
    function s(){var p=r.classList.contains('paused');b.setAttribute('aria-pressed',p);b.textContent=p?'움직임 다시 켜기':'움직임 멈추기'}
    b.addEventListener('click',function(){r.classList.toggle('paused');try{localStorage.setItem('motion',r.classList.contains('paused')?'off':'on')}catch(e){}s()});s();})();
  </script>
</body></html>
