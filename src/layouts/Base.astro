---
import '../styles/global.css';
interface Props { title?: string; desc?: string; nav?: string }
const { title = '권주회 · 프론트엔드 포트폴리오', desc = '사용자의 흐름을 끝까지 다듬는 프론트엔드 개발자 권주회의 작업 기록', nav = '' } = Astro.props;
const links = [['/#about', '소개'], ['/#projects', '프로젝트'], ['/#skills', '기술 활용'], ['/#contact', '연락']];
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title><meta name="description" content={desc} />
  <meta property="og:title" content={title} /><meta property="og:description" content={desc} /><meta name="theme-color" content="#f4efe5" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='3' fill='%238e3a2a'/%3E%3Ctext x='16' y='23' font-size='20' text-anchor='middle' fill='%23f8efe0' font-family='serif'%3E權%3C/text%3E%3C/svg%3E" />
  <script is:inline>try{if(localStorage.getItem('motion')==='off')document.documentElement.classList.add('paused')}catch(e){}</script>
</head>
<body>
  <a class="skip" href="#main">본문으로 건너뛰기</a>
  <div class="sky" aria-hidden="true"><div class="land"></div><div class="mist m1"></div><div class="mist m2"></div></div>
  </div>
  <header class="top"><div class="wrap">
    <a class="brand" href="/" aria-label="홈"><span class="seal" aria-hidden="true">權</span><span class="t">권주회 · 작업 기록</span></a>
    <nav class="nav" aria-label="주 메뉴">{links.map(([h, t]) => <a href={h} aria-current={nav === h ? 'page' : undefined}>{t}</a>)}</nav>
    <button class="mbtn" id="motion" type="button" aria-pressed="false">움직임 멈추기</button>
  </div></header>
  <main id="main"><slot /></main>
  <footer class="foot"><div class="wrap">
    <p>© 2026 권주회 · 프론트엔드 개발자 포트폴리오</p>
    
  </div></footer>
  <script is:inline>
    (function(){var b=document.getElementById('motion'),r=document.documentElement;
    function s(){var p=r.classList.contains('paused');b.setAttribute('aria-pressed',p);b.textContent=p?'움직임 다시 켜기':'움직임 멈추기'}
    b.addEventListener('click',function(){r.classList.toggle('paused');try{localStorage.setItem('motion',r.classList.contains('paused')?'off':'on')}catch(e){}s()});s();})();
  </script>
</body></html>
