---
// 배경 수묵화의 "밝은 영역(안개·구름결)"만 GPU 셰이더로 천천히 일렁이게 한다. 어두운 바위·소나무는 고정.
// WebGL 불가 / 움직임 줄이기 설정이면 CSS 정지 이미지(.land)만 보인다.
---
<canvas class="land-gl" aria-hidden="true"></canvas>
<script>
  const canvas = document.querySelector('.land-gl') as HTMLCanvasElement | null;
  const sky = document.querySelector('.sky') as HTMLElement | null;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  if (canvas && sky && !reduce.matches) {
    const gl = canvas.getContext('webgl', { alpha: false, antialias: false, powerPreference: 'low-power' });
    if (gl) start(gl);
  }
  function start(gl: WebGLRenderingContext) {
    const VS = 'attribute vec2 p; varying vec2 v; void main(){ v = vec2(p.x*.5+.5, .5-p.y*.5); gl_Position = vec4(p,0.,1.); }';
    const FS = `precision mediump float; varying vec2 v; uniform sampler2D img; uniform vec2 res, ires; uniform float t, ax;
      float h(vec2 p){ return fract(sin(dot(p, vec2(127.1,311.7))) * 43758.5453); }
      float n(vec2 p){ vec2 i = floor(p), f = fract(p); f = f*f*(3.-2.*f); return mix(mix(h(i), h(i+vec2(1,0)), f.x), mix(h(i+vec2(0,1)), h(i+vec2(1,1)), f.x), f.y); }
      float fbm(vec2 p){ return .55*n(p) + .3*n(p*2.03+7.1) + .15*n(p*4.1+3.3); }
      void main(){
        float sc = max(res.x/ires.x, res.y/ires.y); vec2 size = ires*sc;
        vec2 off = vec2((res.x-size.x)*ax, res.y-size.y);        // cover, 아래 정렬
        vec2 uv = (v*res - off) / size;
        float l = dot(texture2D(img, uv).rgb, vec3(.299,.587,.114));
        // 주변에 어두운 픽셀(바위·소나무)이 있으면 고정: 이웃 4방향의 최소 밝기를 쓴다
        l = min(l, dot(texture2D(img, uv + vec2(.012,0.)).rgb, vec3(.299,.587,.114)));
        l = min(l, dot(texture2D(img, uv - vec2(.012,0.)).rgb, vec3(.299,.587,.114)));
        l = min(l, dot(texture2D(img, uv + vec2(0.,.022)).rgb, vec3(.299,.587,.114)));
        l = min(l, dot(texture2D(img, uv - vec2(0.,.022)).rgb, vec3(.299,.587,.114)));
        float m = smoothstep(.70, .86, l);                       // 밝은 안개·구름결만 흐른다
        vec2 q = uv*vec2(2.6,4.2) + vec2(t*.03, -t*.011);
        vec2 w = vec2(fbm(q), fbm(q + vec2(5.2,1.7))) - .5;
        vec2 d = w * .04 * m;
        d.x += sin(uv.y*9. + t*.3) * .008 * m;                 // 가로로 천천히 흐르는 결
        d.y += sin(uv.x*7. - t*.24) * .004 * m;
        gl_FragColor = texture2D(img, uv + d);
      }`;
    const sh = (type: number, src: string) => { const s = gl.createShader(type)!; gl.shaderSource(s, src); gl.compileShader(s); return gl.getShaderParameter(s, gl.COMPILE_STATUS) ? s : null; };
    const vs = sh(gl.VERTEX_SHADER, VS), fs = sh(gl.FRAGMENT_SHADER, FS); if (!vs || !fs) return;
    const pr = gl.createProgram()!; gl.attachShader(pr, vs); gl.attachShader(pr, fs); gl.linkProgram(pr); if (!gl.getProgramParameter(pr, gl.LINK_STATUS)) return; gl.useProgram(pr);
    const buf = gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER, buf); gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(pr, 'p'); gl.enableVertexAttribArray(loc); gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
    const U = (k: string) => gl.getUniformLocation(pr, k);
    const img = new Image(); img.decoding = 'async'; img.src = '/img/ink/landscape.webp';
    let raf = 0, last = 0, t0 = performance.now(), ready = false;
    const resize = () => { const dpr = Math.min(devicePixelRatio || 1, 1.25), w = Math.round(innerWidth * dpr), h = Math.round(innerHeight * dpr); if (canvas!.width !== w || canvas!.height !== h) { canvas!.width = w; canvas!.height = h; gl.viewport(0, 0, w, h); } };
    const frame = (now: number) => {
      raf = requestAnimationFrame(frame);
      if (document.hidden || document.documentElement.classList.contains('paused') || now - last < 33) return; last = now;   // 30fps, 숨김/정지 시 건너뜀
      resize(); gl.uniform2f(U('res'), canvas!.width, canvas!.height); gl.uniform2f(U('ires'), img.naturalWidth, img.naturalHeight);
      gl.uniform1f(U('t'), (now - t0) / 1000); gl.uniform1f(U('ax'), innerWidth < 700 ? .3 : .5); gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
      if (!ready) { ready = true; sky!.classList.add('gl-on'); }
    };
    img.onload = () => {
      const tex = gl.createTexture(); gl.bindTexture(gl.TEXTURE_2D, tex);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE); gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR); gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGB, gl.RGB, gl.UNSIGNED_BYTE, img); gl.uniform1i(U('img'), 0);
      raf = requestAnimationFrame(frame);
    };
    reduce.addEventListener('change', () => { if (reduce.matches) { cancelAnimationFrame(raf); sky!.classList.remove('gl-on'); } });
  }
</script>
<style is:global>
  .land-gl { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .sky.gl-on .land { opacity: 0; }
</style>
