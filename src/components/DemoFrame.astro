---
// 데모 = 원본 프로젝트의 프론트엔드 화면을 그대로 빌드한 정적 앱(백엔드 없음, 더미 데이터).
// 성능: 포스터만 먼저 보여주고, "실행"을 눌러야 iframe 을 만든다 → 눌러야만 번들을 내려받는다.
interface Props { kind: 'hanpage' | 'focusmate' | 'onwear' | 'daltoori'; name: string; poster: string }
const { kind, name, poster } = Astro.props;
const phone = kind === 'daltoori';
const src = `/demos/${kind}/`;
---
<div class:list={['dframe', phone && 'phone']} data-src={src} data-title={`${name} 데모`}>
  <div class="dwin">
    <div class="dbar" aria-hidden="true"><span>{phone ? 'mobile, 390 × 780' : `${name} / demo`}</span></div>
    <div class="dstage">
      <img class="dposter" src={poster} alt="" loading="lazy" decoding="async" />
      <button class="btn dplay" type="button">▶ 데모 실행</button>
    </div>
  </div>
  <p class="dnote">직접 눌러보세요, <a href={src} target="_blank" rel="noopener">새 탭에서 열기 ↗</a></p>
</div>
<style>
  .dframe { margin: 0 auto; max-width: 1080px; }
  .dframe.phone { max-width: 410px; }
  .dwin { border: 1px solid var(--line); background: #1f1b17; border-radius: 8px; overflow: hidden; box-shadow: 0 18px 40px -22px rgba(40,25,10,.6); }
  .phone .dwin { border: 8px solid #1b1b1b; border-radius: 34px; }
  .dbar { display: flex; align-items: center; gap: 6px; padding: 7px 12px; background: #e9e1d2; font-size: 12px; color: var(--ink-2); }
  .phone .dbar { display: none; }
  .dbar span { margin-left: 8px; }
  .dstage { position: relative; aspect-ratio: 16/10; min-height: 420px; background: var(--paper-2); display: grid; place-items: center; }
  .phone .dstage { aspect-ratio: 390/780; min-height: 0; }
  .dposter { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; opacity: .55; filter: saturate(.8); }
  .phone .dposter { object-fit: contain; }
  .dplay { position: relative; font-size: 1.05rem; padding: .9rem 1.8rem; box-shadow: 0 8px 24px rgba(0,0,0,.35); }
  .dframe :global(iframe) { display: block; width: 100%; height: 100%; border: 0; background: #fff; position: absolute; inset: 0; }
  .dnote { text-align: center; font-size: .85rem; color: var(--ink-2); margin-top: .8rem; }
  @media (max-width: 700px) { .dstage { aspect-ratio: auto; height: 70vh; } }
</style>
<script>
  document.querySelectorAll<HTMLElement>('.dframe').forEach(f => {
    const btn = f.querySelector('.dplay') as HTMLButtonElement; const stage = f.querySelector('.dstage') as HTMLElement;
    btn.addEventListener('click', () => {
      const i = document.createElement('iframe'); i.title = f.dataset.title || 'demo'; i.src = f.dataset.src!;
      i.setAttribute('allow', 'clipboard-write'); stage.replaceChildren(i);
    }, { once: true });
  });
</script>
