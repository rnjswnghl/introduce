---
import type { Project } from '../data/projects';
const { p } = Astro.props as { p: Project };
const icon = p.slug === 'daltoori';
---
<a class="card panel" href={`/projects/${p.slug}`} style={`--accent:${p.accent}`}>
  {p.cover && <div class:list={['cv', icon && 'i']}>
    <img src={`/img/p/${p.cover}.webp`} alt="" loading="lazy" decoding="async" width="1000" height="625" />
  </div>}
  <div class="bd">
    <h4>{p.name}</h4>
    <p class="sub">{p.period}</p>
    <p class="key">{p.roleShort} <span style="font-weight:400;color:var(--ink-2)">/ {p.kind === 'solo' ? '개인' : `${p.teamSize}인 팀`}</span></p>
    <div class="tags">
      {p.demo && <span class="tag cel">▶ 데모</span>}
    </div>
  </div>
</a>
