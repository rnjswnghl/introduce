---
import type { Project } from '../data/projects';
const { p } = Astro.props as { p: Project };
const icon = p.cover.endsWith('-icon');
const site = p.links.find(l => l.label === '서비스' || l.label === '실험 사이트');
---
<div class="card panel" style={`--accent:${p.accent}`}>
  {p.cover && <div class:list={['cv', icon && 'i']}>
    <img src={`/img/p/${p.cover}.webp`} alt="" loading="lazy" decoding="async" width="1000" height="625" />
  </div>}
  <div class="bd">
    <h4><a class="stretch" href={`/projects/${p.slug}`}>{p.name}</a></h4>
    <p class="sub">{p.kor}</p>
    <p class="per">{p.period}</p>
    <p class="key">{p.roleShort} <span style="font-weight:400;color:var(--ink-2)">/ {p.kind === 'solo' ? '개인' : `${p.teamSize}인 팀`}</span></p>
    <div class="tags">
      {p.demo && <span class="tag cel">▶ 데모</span>}
      {site && <a class="site" href={site.href} target="_blank" rel="noopener">사이트 바로가기 ↗</a>}
    </div>
  </div>
</div>
