---
// 풍등 아이콘: 직육면체(앞면·옆면·윗면) 종이 등롱. 먹선 + 주홍 선, 색 채움 없음(노란 불빛 없음).
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<svg class:list={['lantern', cls]} viewBox="0 0 64 74" aria-hidden="true" focusable="false">
  <g transform="rotate(5 30 30)">
    <path class="ln" d="M29 1.500h8M33 1.500V8" />
    <path class="face side" d="M42 15L50 10.500V42L42 46.500Z" />
    <path class="face top" d="M17.500 15L26 10.500H50L42 15Z" />
    <path class="face front" d="M17.500 15H42V46.500H17.500Z" />
    <path class="rib" d="M25.500 15V46.500M34 15V46.500M42 15L50 10.500" />
    <path class="rib" d="M17.500 20H42M17.500 41.500H42M42 20L50 15.500M42 41.500L50 37" />
    <path class="ln" d="M16 15h27.500M16 46.500h27.500" />
    <text x="29.800" y="29.500">J</text><text x="29.800" y="38.500">H</text>
    <path class="tas" d="M25 47.500c-.5 4-3.500 7-7 9.500-3 2-5 5-6 9M30 47.500c0 5-2 9-6 13-2 2-3 5-3.500 9M35 47.500c1 4-.5 7-3.500 10-2 2-3 4-3.500 7" />
  </g>
</svg>
<style>
  .lantern { display: block; overflow: visible; color: var(--seal); }
  .lantern .ln, .lantern .rib, .lantern .tas, .lantern .face { stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; }
  .lantern .ln { fill: none; stroke-width: 1.6; } .lantern .rib { fill: none; stroke-width: .8; opacity: .55; } .lantern .tas { fill: none; stroke-width: .95; }
  .lantern .face { stroke-width: 1.5; } .lantern .front { fill: #faf6ee; } .lantern .side { fill: #e7ddcd; } .lantern .top { fill: #f1e9db; }
  .lantern text { fill: currentColor; font: 700 8.5px/1 var(--serif); text-anchor: middle; }
</style>
