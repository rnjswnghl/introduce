---
// 풍등(등롱) 아이콘: 위의 구슬, 두 단 뚜껑, 가운데가 불룩한 몸통과 곡선 살대, 아래 두 단 뚜껑, 술. 선화, 색 채움 없음.
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<svg class:list={['lantern', cls]} viewBox="0 0 64 98" aria-hidden="true" focusable="false">
  <circle class="ln" cx="32" cy="5.500" r="4.300" />
  <path class="ln" d="M29 9.800h6V13.500h-6Z" />
  <rect class="ln" x="24.500" y="13.500" width="15" height="3.300" rx="1" />
  <rect class="ln" x="19" y="16.800" width="26" height="4" rx="1.200" />
  <path class="ln body" d="M19.500 20.800C5 27 4 56 19.500 62.500H44.500C60 56 59 27 44.500 20.800Z" />
  <path class="rib" d="M23 20.800C10.500 28 10.500 55.500 23 62.500M41 20.800C53.500 28 53.500 55.500 41 62.500" />
  <path class="rib" d="M27.500 20.800C18.500 29 18.500 54.500 27.500 62.500M36.500 20.800C45.500 29 45.500 54.500 36.500 62.500" />
  <rect class="ln" x="19" y="62.500" width="26" height="4" rx="1.200" />
  <rect class="ln" x="24.500" y="66.500" width="15" height="3.300" rx="1" />
  <path class="ln" d="M29.500 69.800h5V72.500h-5Z" />
  <circle class="ln" cx="32" cy="75.500" r="2.300" />
  <rect class="ln" x="29.300" y="78" width="5.400" height="5.500" rx="1.600" />
  <g class="tas"><path d="M29.800 83.500C29.300 87 28 90 27 94.500" /><path d="M30.700 83.500C30.500 88 29.500 91 29 96" /><path d="M31.600 83.500C31.600 88 31 92 31 97" /><path d="M32.400 83.500C32.400 88 33 92 33 97" /><path d="M33.300 83.500C33.500 88 34.500 91 35 96" /><path d="M34.200 83.500C34.700 87 36 90 37 94.500" /></g>
  <text x="32" y="38.500">J</text><text x="32" y="49">H</text>
</svg>
<style>
  .lantern { display: block; overflow: visible; color: var(--seal); }
  .lantern .ln, .lantern .rib, .lantern .tas path { stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; fill: none; }
  .lantern .ln { stroke-width: 1.5; fill: #fdfaf3; } .lantern .rib { stroke-width: 1.2; } .lantern .tas path { stroke-width: .9; }
  .lantern .body { fill: #fdfaf3; }
  .lantern text { fill: currentColor; font: 700 9px/1 var(--serif); text-anchor: middle; }
</style>
