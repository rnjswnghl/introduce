---
// 풍등 아이콘: 둥근 지붕 처마 · 살짝 볼록한 부드러운 몸통 · 곡선 살대 · 부채꼴로 풍성하게 흐르는 술. 색 채움 없음(노란 불빛 없음).
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<svg class:list={['lantern', cls]} viewBox="0 0 72 86" aria-hidden="true" focusable="false">
  <g transform="rotate(4 36 32)">
    <circle class="ln" cx="36" cy="3.200" r="1.800" />
    <path class="ln" d="M36 5V10" />
    <path class="face cap" d="M19.500 18C19.500 12 27 9.500 36 9.500S52.500 12 52.500 18Q36 20.500 19.500 18Z" />
    <path class="face body" d="M22 18.500C19.500 28 19.500 39 22.500 48.500Q23.500 51.500 27 51.500H45Q48.500 51.500 49.500 48.500C52.500 39 52.500 28 50 18.500Q36 21 22 18.500Z" />
    <path class="rib" d="M29 20C27.500 30 27.500 41 29 50.500M43 20C44.500 30 44.500 41 43 50.500" />
    <path class="face cap" d="M25 51.500Q36 54 47 51.500V54Q47 57 44 57H28Q25 57 25 54Z" />
    <text x="36" y="32.500">J</text><text x="36" y="42.500">H</text>
    <ellipse class="knot" cx="36" cy="58.500" rx="4.500" ry="2.200" />
    <g class="tas">
      <path d="M29.500 58C23 63 30 69 20 79" /><path d="M31 58.500C26 65 33 71 25 82" /><path d="M33 59C29 66 36 73 30 84" />
      <path d="M35 59.500C33 67 38 74 35 85.500" /><path d="M37 59.500C40 66 35 73 39 84.500" /><path d="M39 59C44 65 38 71 45 83" />
      <path d="M41 58.500C47 63 41 69 51 79" /><path d="M32 59C27 62 33 66 23 69" opacity=".7" /><path d="M40 59C45 61 40 65 50 66" opacity=".7" />
    </g>
  </g>
</svg>
<style>
  .lantern { display: block; overflow: visible; color: var(--seal); }
  .lantern .ln, .lantern .rib, .lantern .tas path, .lantern .face, .lantern .knot { stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; }
  .lantern .ln { fill: none; stroke-width: 1.4; } .lantern .rib { fill: none; stroke-width: .8; opacity: .45; } .lantern .tas path { fill: none; stroke-width: .9; }
  .lantern .face { stroke-width: 1.3; } .lantern .body { fill: #faf6ee; } .lantern .cap { fill: #efe6d6; } .lantern .knot { fill: #efe6d6; stroke-width: 1.1; }
  .lantern text { fill: currentColor; font: 700 9px/1 var(--serif); text-anchor: middle; }
</style>
