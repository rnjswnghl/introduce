---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import '../styles/pages.css';
const ssafy = projects.filter(p => p.group === 'ssafy'), aleph = projects.filter(p => p.group === 'aleph');
const link = (s: string) => `/projects/${s}`;
const skills = [
  { t: 'Frontend', tags: ['Vue 3', 'React', 'TypeScript', 'Pinia', 'Zustand', 'Emotion', 'Vite'], n: '한페이지·FocusMate·On-Wear' },
  { t: 'Backend', tags: ['Django REST', 'FastAPI', 'SQLite', 'Next.js'], n: '한페이지·DALTOORI·LLM Gateway' },
  { t: 'AI · 음성', tags: ['Whisper', 'MFA', 'MeloTTS', 'LLM API', 'Gemini'], n: 'DALTOORI의 발음 평가 파이프라인' },
  { t: 'Web · Canvas', tags: ['Canvas API', 'Web Audio', 'D3', 'Chart.js'], n: 'BurnIt · Cut&Note · byeol' },
  { t: '품질 · 협업', tags: ['Playwright', 'pytest', 'Vitest', 'Git Flow', 'PR 리뷰'], n: 'LLM Gateway 테스트 189개' },
  { t: '배포', tags: ['Vercel', 'Docker', 'Railway', 'Cloudflare D1', 'Neon'], n: '' },
];
---
<Base>
  <section class="hero"><div class="wrap">
    <div class="grid">
      <div>
        <p class="eyebrow">Frontend Developer Portfolio</p>
        <h1>사용자의 흐름을<br /><em>끝까지</em> 다듬는 개발자.</h1>
        <p class="lead">화면을 구현하는 데서 멈추지 않고, 사용자가 실제로 마주하는 검색·권한·상태 흐름이 끝까지 동작하는지 확인합니다. React·Vue 중심으로 일하며 필요하면 Django·FastAPI까지 범위를 넓혔습니다.</p>
        <p style="display:flex;gap:.7rem;flex-wrap:wrap;margin-top:1.6rem"><a class="btn" href="#projects">프로젝트 보기 →</a><a class="btn ghost" href="/performance">이 사이트가 빠른 이유</a></p>
      </div>
      <div class="vert" aria-hidden="true"><span>권주회</span><span class="seal">權</span></div>
    </div>
    <div class="stats" role="list">
      <div role="listitem"><b>10</b><small>프로젝트 · 팀 5 / 개인 5</small></div>
      <div role="listitem"><b>370+</b><small>본인 계정 커밋 합계 (git 이력 집계)</small></div>
      <div role="listitem"><b>4</b><small>직접 눌러볼 수 있는 원본 화면 데모</small></div>
      <div role="listitem"><b>57–73%</b><small>2·6인 팀에서의 커밋 비중 (한페이지·Gateway)</small></div>
      <div role="listitem"><b>−95%</b><small>캡처 이미지 17.0MB → 0.9MB</small></div>
    </div>
  </div></section>

  <hr class="rule" />
  <section id="about"><div class="wrap about">
    <div>
      <p class="eyebrow">About</p>
      <h2 class="h2">화면과 데이터를<br />연결하는 개발자.</h2>
      <p>러시아학과 빅데이터학을 공부한 뒤 웹 개발 프로젝트를 수행했습니다. 검색과 필터, 권한별 화면, 상태 관리와 API 연동처럼 사용자가 직접 마주하는 흐름을 주로 다뤘고, 구현한 뒤 실제 사용 과정에서 생기는 오류를 다시 확인해 개선합니다.</p>
      <p>SSAFY에서 4개의 팀 프로젝트를, K-디지털 트레이닝 Aleph에서 AI 에이전트와 함께 6개의 프로젝트를 만들었습니다. AI가 쓴 코드를 어디까지 이해하고 검증했는지를 프로젝트마다 솔직하게 적었습니다.</p>
      <div class="vals">
        <div class="val panel"><span class="n">壹</span><h4>끈기</h4><p>인증 오류와 병합 충돌로 끊긴 기능을 끝까지 복구했습니다.</p><a href={link('hanpage')}>한페이지 →</a></div>
        <div class="val panel"><span class="n">貳</span><h4>주도성</h4><p>검색부터 결과·찜까지, 흐름 전체를 먼저 잡고 구현했습니다.</p><a href={link('on-wear')}>On-Wear →</a></div>
        <div class="val panel"><span class="n">參</span><h4>책임감</h4><p>권한별 화면과 세션 오류를 마지막까지 정리했습니다.</p><a href={link('focusmate')}>FocusMate →</a></div>
      </div>
    </div>
    <div class="polas" aria-hidden="false">
      <div class="pola a"><img src="/img/ink/courtyard.webp" alt="붉은 단풍 아래 고요한 한옥 마당을 그린 AI 이미지" width="760" height="760" loading="lazy" /><span>천천히, 그러나 끝까지.</span></div>
      <div class="pola b"><img src="/img/ink/desk.webp" alt="한옥 창가의 책과 찻잔, 은행잎을 그린 AI 이미지" width="760" height="760" loading="lazy" /><span>배운 것을 코드로 옮깁니다.</span></div>
    </div>
  </div></section>

  <hr class="rule" />
  <section id="projects"><div class="wrap">
    <p class="eyebrow">Projects · 10</p>
    <h2 class="h2">작업 기록</h2>
    <p class="lead">▶ 표시가 있는 프로젝트는 상세 페이지에서 더미 데이터로 동작하는 데모를 직접 눌러볼 수 있습니다. 모든 수치는 저장소에서 직접 집계했고, 근거를 상세 페이지에 함께 적었습니다.</p>
    <div class="pgroup"><h3>SSAFY 팀 프로젝트</h3><div class="cards">{ssafy.map(p => <ProjectCard p={p} />)}</div></div>
    <div class="pgroup"><h3>K-디지털 트레이닝 Aleph · AI 협업 개발</h3><div class="cards">{aleph.map(p => <ProjectCard p={p} />)}</div></div>
  </div></section>

  <hr class="rule" />
  <section id="skills"><div class="wrap">
    <p class="eyebrow">Skills</p><h2 class="h2">쓴 기술과 쓴 곳</h2>
    <div class="skills">{skills.map(s => <div class="skill panel"><h4>{s.t}</h4><div class="tags">{s.tags.map(t => <span class="tag">{t}</span>)}</div>{s.n && <small>{s.n}</small>}</div>)}</div>
  </div></section>

  <hr class="rule" />
  <section id="contact"><div class="wrap">
    <p class="eyebrow">Contact</p><h2 class="h2">함께 이야기해요</h2>
    <p class="lead">코드와 작업 이력은 GitHub에서 확인할 수 있습니다.</p>
    <p style="display:flex;gap:.7rem;flex-wrap:wrap"><a class="btn" href="https://github.com/rnjswnghl" rel="noopener">GitHub · rnjswnghl ↗</a></p>
  </div></section>
</Base>
