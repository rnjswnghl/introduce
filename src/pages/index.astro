---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import { profile, peers, timeline, skills, levelLabel } from '../data/profile';
import '../styles/pages.css';
const ssafy = projects.filter(p => p.group === 'ssafy'), aleph = projects.filter(p => p.group === 'aleph');
const link = (s: string) => `/projects/${s}`;
---
<Base>
  <section class="hero"><div class="wrap">
    <div class="grid">
      <div>
        <p class="eyebrow">Developer Portfolio / {profile.en}</p>
        <h1>시작하면<br /><em>쉽게 놓지 않는</em> 개발자.</h1>
        <p class="lead">{profile.one}</p>
        <p style="display:flex;gap:.7rem;flex-wrap:wrap;margin-top:1.6rem"><a class="btn" href="#projects">프로젝트 보기 →</a><a class="btn ghost" href="#skills">기술 보기</a></p>
      </div>
      <div class="vert" aria-hidden="true"><span>{profile.name}</span></div>
    </div>
  </div></section>

  <hr class="rule" />
  <section id="about"><div class="wrap about">
    <p class="eyebrow">Profile</p>
    <h2 class="h2">저는 이런 개발자입니다.</h2>
    <p>러시아학과 빅데이터학을 공부한 뒤 웹 개발 프로젝트를 수행했습니다. 검색과 필터, 권한별 화면, 상태 관리처럼 사용자가 직접 마주하는 흐름을 주로 다뤘고, 화면(Vue, React)에서 API(Django, FastAPI), AI 연동까지 서비스를 이어서 구현합니다.</p>
    <p>모르는 것은 이해할 때까지 묻고, 도구를 바꿔가며 시도합니다. 함께한 동료들은 저를 “{peers[0].t.replace('하는 사람','하고')}, {peers[1].t.replace('하는 사람','하는 사람')}”이라고 말합니다.</p>
    <h3 class="subh">핵심 가치</h3>
    <div class="vals2">{profile.values.map(v => <div><b>{v.t}</b><span>{v.d}</span></div>)}</div>
  </div></section>

  <hr class="rule" />
  <section id="skills"><div class="wrap">
    <p class="eyebrow">Skills</p><h2 class="h2">기술과 활용 수준</h2>
    <p class="lead" style="margin-bottom:.8rem">쓴 기술의 목록이 아니라, 프로젝트에서 어디까지 직접 했는지를 3단계로 표시했습니다.</p>
    <p class="legend" aria-label="범례">{[1, 2, 3].map(n => <span><i class={`dots l${n}`} aria-hidden="true"></i>{levelLabel[n]}</span>)}</p>
    <div class="skillgrid">{skills.map(g => <div class="panel sk"><h4>{g.cat}</h4>{g.items.map(i => <a class="row" href={link(i.p)}><span class="nm">{i.t}{i.draft && <span class="tag" title="본인 확인이 필요합니다.">검수 전</span>}</span><i class={`dots l${i.lv}`} role="img" aria-label={levelLabel[i.lv]}></i><span class="ds">{i.d}</span></a>)}</div>)}</div>
  </div></section>

  <hr class="rule" />
  <section id="projects"><div class="wrap">
    <p class="eyebrow">Projects</p>
    <h2 class="h2">작업 기록</h2>
    <p class="lead">프로젝트마다 개요, 문제 정의, 설계, 맡은 역할, 문제 해결, 회고를 정리했습니다. ▶ 표시가 있는 프로젝트는 화면을 직접 눌러볼 수 있습니다.</p>
    <div class="pgroup"><h3>SSAFY 팀 프로젝트</h3><div class="cards">{ssafy.map(p => <ProjectCard p={p} />)}</div></div>
    <div class="pgroup"><h3>K-뉴딜 Aleph, AI 협업 개발</h3><div class="cards">{aleph.map(p => <ProjectCard p={p} />)}</div></div>
  </div></section>

  <hr class="rule" />
  <section id="history"><div class="wrap">
    <p class="eyebrow">Experience</p><h2 class="h2">이력</h2>
    <ol class="tl">{timeline.map(t => <li><span class="when">{t.when}{t.state && <b class="tag cel">{t.state}</b>}</span><div><h4>{t.t}{t.draft && <span class="tag" title="본인 확인이 필요한 문구입니다.">검수 전</span>}</h4><p class="org">{[t.org, t.role].filter(Boolean).join(', ')}</p><p>{t.d}{t.link && <> <a href={t.link}>프로젝트 →</a></>}</p></div></li>)}</ol>
  </div></section>

  <hr class="rule" />
  <section id="contact"><div class="wrap">
    <p class="eyebrow">Contact</p><h2 class="h2">함께 이야기해요</h2>
    <p class="lead">코드와 작업 이력은 GitHub에서, 경력은 LinkedIn에서 확인할 수 있습니다.</p>
    <p style="display:flex;gap:.7rem;flex-wrap:wrap"><a class="btn" href="https://github.com/rnjswnghl" rel="noopener">GitHub, rnjswnghl ↗</a><a class="btn ghost" href="https://www.linkedin.com/in/joohoe-kwon" rel="noopener">LinkedIn ↗</a></p>
  </div></section>
</Base>
